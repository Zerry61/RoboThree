{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robothree.local/contracts/enterprise-gateway/v1alpha1/access-token-claims.schema.json",
  "title": "RoboThree Enterprise Access Token Claims",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "issuer",
    "audience",
    "enterpriseId",
    "userId",
    "deviceId",
    "clientInstanceId",
    "tokenId",
    "issuedAt",
    "expiresAt",
    "permissions"
  ],
  "properties": {
    "contractVersion": { "const": "v1alpha1" },
    "issuer": { "type": "string", "minLength": 3, "maxLength": 256 },
    "audience": { "type": "string", "minLength": 3, "maxLength": 256 },
    "enterpriseId": { "type": "string", "minLength": 3, "maxLength": 160 },
    "userId": { "type": "string", "minLength": 3, "maxLength": 160 },
    "deviceId": { "type": "string", "minLength": 3, "maxLength": 160 },
    "clientInstanceId": { "type": "string", "format": "uuid" },
    "tokenId": { "type": "string", "format": "uuid" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "configuration.read",
          "model.use",
          "tool.use",
          "agent.use",
          "skill.use",
          "knowledge.use"
        ]
      }
    }
  }
}
