{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robothree.local/contracts/enterprise-gateway/v1alpha1/device-challenge.schema.json",
  "title": "Enterprise Device Challenge and Proof",
  "oneOf": [
    { "$ref": "#/$defs/deviceChallengeRequest" },
    { "$ref": "#/$defs/deviceChallenge" }
  ],
  "$defs": {
    "deviceChallengeRequest": {
      "oneOf": [
        { "$ref": "#/$defs/tokenChallengeRequest" },
        { "$ref": "#/$defs/enrollmentChallengeRequest" }
      ]
    },
    "tokenChallengeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "contractVersion",
        "purpose",
        "verifiedIdentityId",
        "clientInstanceId",
        "deviceKeyId"
      ],
      "properties": {
        "type": { "const": "issue_device_challenge_request" },
        "contractVersion": { "const": "v1alpha1" },
        "purpose": { "const": "token_issuance" },
        "verifiedIdentityId": { "type": "string", "format": "uuid" },
        "clientInstanceId": { "type": "string", "format": "uuid" },
        "deviceKeyId": { "type": "string", "minLength": 3, "maxLength": 160 }
      }
    },
    "enrollmentChallengeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "contractVersion",
        "purpose",
        "verifiedIdentityId",
        "clientInstanceId",
        "deviceEnrollmentCode",
        "publicKeyDigest"
      ],
      "properties": {
        "type": { "const": "issue_device_challenge_request" },
        "contractVersion": { "const": "v1alpha1" },
        "purpose": { "const": "device_enrollment" },
        "verifiedIdentityId": { "type": "string", "format": "uuid" },
        "clientInstanceId": { "type": "string", "format": "uuid" },
        "deviceEnrollmentCode": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "publicKeyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "deviceChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "contractVersion",
        "challengeId",
        "nonce",
        "issuedAt",
        "expiresAt",
        "audience",
        "clientInstanceId",
        "allowedAlgorithms"
      ],
      "properties": {
        "type": { "const": "device_challenge" },
        "contractVersion": { "const": "v1alpha1" },
        "challengeId": { "type": "string", "format": "uuid" },
        "nonce": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "audience": { "type": "string", "minLength": 3, "maxLength": 160 },
        "clientInstanceId": { "type": "string", "format": "uuid" },
        "allowedAlgorithms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "deviceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challengeId",
        "deviceKeyId",
        "algorithm",
        "signature",
        "signedAt"
      ],
      "properties": {
        "challengeId": { "type": "string", "format": "uuid" },
        "deviceKeyId": { "type": "string", "minLength": 3, "maxLength": 160 },
        "algorithm": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]+$"
        },
        "signature": {
          "type": "string",
          "minLength": 32,
          "maxLength": 8192,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
