{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robothree.local/contracts/enterprise-gateway/v1alpha2/compatibility.schema.json",
  "title": "Enterprise Gateway Compatibility v1alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "centralVersion",
    "supportedContractVersions",
    "minimumDesktopVersion",
    "minimumCoreVersion",
    "features",
    "maintenanceStatus",
    "configurationSchemaVersions"
  ],
  "properties": {
    "contractVersion": { "const": "v1alpha2" },
    "centralVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "supportedContractVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["v1alpha1", "v1alpha2"] }
    },
    "minimumDesktopVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "minimumCoreVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "features": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "configuration_snapshot",
          "package_document",
          "fixed_permissions",
          "enterprise_identity",
          "managed_device_trust",
          "manual_device_enrollment",
          "enterprise_model_gateway",
          "enterprise_model_prompt_cache_v1alpha2"
        ]
      }
    },
    "maintenanceStatus": {
      "enum": ["available", "degraded", "maintenance"]
    },
    "configurationSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "const": "v1alpha1" }
    }
  }
}
