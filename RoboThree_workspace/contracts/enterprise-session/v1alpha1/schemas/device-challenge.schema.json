{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robothree.local/contracts/enterprise-session/v1alpha1/schemas/device-challenge.schema.json",
  "title": "RoboThree Enterprise Session Device Challenge",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "schemaVersion", "verifiedIdentityHandle", "currentClientInstanceId",
        "audience", "requiredPermissions", "deviceKeyId", "correlationId"
      ],
      "properties": {
        "kind": { "const": "enterprise_session_device_challenge_request" },
        "schemaVersion": { "const": "enterprise-session.v1alpha1" },
        "verifiedIdentityHandle": { "$ref": "common.schema.json#/$defs/verifiedIdentityHandle" },
        "currentClientInstanceId": { "$ref": "common.schema.json#/$defs/uuid" },
        "audience": { "$ref": "common.schema.json#/$defs/audience" },
        "requiredPermissions": { "$ref": "common.schema.json#/$defs/requiredPermissions" },
        "deviceKeyId": { "$ref": "common.schema.json#/$defs/identityId" },
        "correlationId": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "schemaVersion", "challengeId", "nonce", "issuedAt", "expiresAt",
        "audience", "currentClientInstanceId", "allowedAlgorithms", "challengeDigest"
      ],
      "properties": {
        "kind": { "const": "enterprise_session_device_challenge" },
        "schemaVersion": { "const": "enterprise-session.v1alpha1" },
        "challengeId": { "$ref": "common.schema.json#/$defs/uuid" },
        "nonce": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "issuedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "audience": { "$ref": "common.schema.json#/$defs/audience" },
        "currentClientInstanceId": { "$ref": "common.schema.json#/$defs/uuid" },
        "allowedAlgorithms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]+$"
          }
        },
        "challengeDigest": { "$ref": "common.schema.json#/$defs/digest" }
      }
    }
  }
}
