{
  "name": "@robothree/desktop",
  "version": "0.0.0-mvp.safe-progress.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b && pnpm run build:preload && pnpm run build:renderer",
    "build:preload": "vite build --config vite.preload.config.mjs",
    "build:renderer": "vite build",
    "build:credential-helper": "node scripts/build-personal-credential-helper.mjs",
    "clean": "node ../../scripts/clean.mjs apps/desktop",
    "start": "env -u ELECTRON_RUN_AS_NODE electron dist/main/index.js",
    "smoke": "node dist/main/foundation-smoke.js",
    "smoke:preload": "env -u ELECTRON_RUN_AS_NODE electron dist/main/preload-smoke.js"
  },
  "dependencies": {
    "@robothree/contracts": "workspace:*",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.2.0",
    "happy-dom": "^20.11.2",
    "vite": "^8.1.5"
  }
}
