{
  "name": "@robothree/admin-console",
  "version": "0.0.0-mvp.rsl.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:integration": "vite build --mode integration",
    "serve:integration": "node scripts/integration-loopback-server.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:negative": "node scripts/assert-negative-typecheck.mjs",
    "test": "vitest run",
    "scan:static": "node scripts/static-scan.mjs",
    "scan:deps": "node scripts/dependency-isolation-scan.mjs",
    "smoke:dev": "node scripts/dev-startup-smoke.mjs"
  },
  "dependencies": {
    "@robothree/contracts": "workspace:*",
    "vue": "2.7.16",
    "vue-router": "3.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue2": "2.3.4",
    "@vue/test-utils": "1.3.6",
    "happy-dom": "20.11.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "vue-template-compiler": "2.7.16",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
